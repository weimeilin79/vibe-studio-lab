# Written by ./setup_codelab.sh — safe to edit, safe to re-run (your values are kept).

# ── auth: Cloud Shell / GEAP via ADC (no keys) ──
STUDIO_VERTEX=1
GOOGLE_CLOUD_PROJECT=pokedemo-test
STUDIO_GCP_PROJECT=pokedemo-test

# ── three services, three locations; they are not interchangeable ──
# Gemini → global: dynamic shared quota across regions (agent/platform/config.py)
GOOGLE_CLOUD_LOCATION=global
# Veo → us-central1: video generation is regional, there is no global endpoint (agent/platform/videogen.py)
STUDIO_VEO_MODEL=veo-3.1-fast-generate-001
STUDIO_VEO_LOCATION=us-central1
# Memory Bank and RAG Engine → us-central1: Agent Engine and RAG are regional (agent/platform/memory.py, rag.py)
GOOGLE_CLOUD_LOCATION_MB=us-central1
GOOGLE_CLOUD_LOCATION_RAG=us-central1

# ── the render: 1 = real Veo (minutes, real credit), 0 = a stand-in that finishes in seconds ──
STUDIO_REAL_VIDEO=1

# ── the room's shared platform ──
VIBETUBE_URL=https://vibetube.dev
VIBETUBE_EVENT=sandbox
VIBETUBE_NAME=Christina Lin
VIBETUBE_PROJECT=christina-lin-vibestudio
